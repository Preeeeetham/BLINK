# BLINK Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# .env is ignored by git and will never be committed.

# MOSDAC Portal Credentials (Optional if configured via UI or config.local.json)
MOSDAC_USERNAME=your_username_or_email@example.com
MOSDAC_PASSWORD=your_mosdac_password

# Data Storage
MOSDAC_DOWNLOAD_PATH=data/raw_netcdf/mosdac

# Server Configuration
BLINK_HOST=127.0.0.1
BLINK_PORT=8000
