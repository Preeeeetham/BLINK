# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node & JS dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Virtual environments
.env
.env.*
!.env.example
*.env
.venv
env/
venv/
ENV/

# Local configuration & secrets
config.local.json
*.local.json
secrets/
*.pem
*.key
*.p12
*.pfx
*.crt
credentials.json
client_secret*.json

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Runtime, logs & transient PID files
*.pid
.blink.pid
*.log
*.tmp
temp/
tmp/
error_logs/
**/error_logs/
logs/
.tempmediaStorage/

# Large raw archives & transient caches (prevents GitHub 100MB+ push rejects)
MOSDAC/
mosdac/
**/MOSDAC/
**/mosdac/
data/raw_netcdf/mosdac/
data/raw_netcdf/real_satellite/
data/raw/*
data/processed/*
!data/raw_netcdf/.gitkeep
!data/processed/.gitkeep

# Allow lightweight plug-and-play scenario HDF5s (total ~6.5MB)
!data/raw_netcdf/*.h5

# Transient archives & compressed dumps
*.tar
*.tar.gz
*.gz
*.zip

# Model weights & checkpoints
checkpoints/
weights/
*.pt
*.pth
*.bin
*.onnx
*.safetensors
