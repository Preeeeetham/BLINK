logs/
.tempmediaStorage/

# Large binaries, arrays & meteorological archives (prevents GitHub 100MB+ push rejects)
*.h5
*.hdf5
*.nc
*.nc4
*.npz
*.npy
*.tar
*.tar.gz
*.gz
*.zip
data/raw/*
data/processed/*
data/exported_images/*
data/raw_netcdf/*
!data/raw_netcdf/.gitkeep
!data/processed/.gitkeep
MOSDAC/
mosdac/
**/MOSDAC/
**/mosdac/

# Model weights & checkpoints
checkpoints/
weights/
*.pt
*.pth
